<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- LibraryImport (job object for tunnel processes) generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The exe's icon (Explorer, pinned taskbar); the window sets its own from the copy next to it. -->
    <ApplicationIcon>yadbc.ico</ApplicationIcon>
    <!-- What Task Manager and the installed app's properties show; the release sets Version from its tag. -->
    <Product>yadbc</Product>
    <AssemblyTitle>yadbc</AssemblyTitle>
    <Version>0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Include="yadbc.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="yadbc.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Yadbc.Contracts\Yadbc.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Framework.Win32.CredentialManager" Version="3.0.5" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
